{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QwenServingRelease",
  "type": "object",
  "required": [
    "schema_version",
    "release_id",
    "git_sha",
    "gateway_image",
    "runtime_image",
    "engine",
    "model",
    "serving",
    "serving_config_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "release_id": {"type": "string", "minLength": 8},
    "git_sha": {"type": "string", "minLength": 7},
    "gateway_image": {"type": "string", "pattern": "@sha256:"},
    "runtime_image": {"type": "string", "pattern": "@sha256:"},
    "engine": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"enum": ["vllm", "sglang"]},
        "version": {"type": "string"},
        "pytorch": {"type": "string"},
        "cuda": {"type": "string"}
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["id", "revision", "dtype"],
      "properties": {
        "id": {"type": "string"},
        "revision": {"type": "string", "minLength": 40},
        "tokenizer_sha256": {"type": "string"},
        "chat_template_sha256": {"type": "string"},
        "dtype": {"type": "string"}
      },
      "additionalProperties": false
    },
    "serving": {
      "type": "object",
      "required": ["max_model_len", "tensor_parallel_size", "gpu_memory_utilization", "chat_template_kwargs"],
      "properties": {
        "max_model_len": {"type": "integer", "minimum": 1},
        "tensor_parallel_size": {"type": "integer", "minimum": 1},
        "gpu_memory_utilization": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "chat_template_kwargs": {
          "type": "object",
          "properties": {"enable_thinking": {"const": false}},
          "required": ["enable_thinking"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "serving_config_sha256": {"type": "string"},
    "benchmark_config_sha256": {"type": "string"}
  },
  "additionalProperties": false
}
