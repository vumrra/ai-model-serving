{
  "title": "Qwen Serving Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "tags": ["qwen", "inference"],
  "panels": [
    {
      "type": "timeseries",
      "title": "Request rate",
      "targets": [{"expr": "sum(rate(qwen_http_requests_total[1m]))"}],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "p95 TTFT",
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(qwen_ttft_seconds_bucket[5m])))"}],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Active requests",
      "targets": [{"expr": "sum(qwen_active_requests)"}],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    }
  ]
}
